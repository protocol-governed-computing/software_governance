{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgs_governance.schemas.SCHEMA_EVENT_V0",
  "title": "OmniBachi Event Schema V0",
  "description": "JSON Schema for materialized event artifacts",
  "type": "object",
  "required": [
    "fqdn",
    "artifact_kind",
    "version",
    "governed_by",
    "core"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "EVENT",
      "description": "Canonical artifact kind discriminator (Kind Vocabulary)."
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version string"
    },
    "governed_by": {
      "type": "string",
      "const": "CONSTITUTION_EVENT_V0",
      "description": "Governing constitution"
    },
    "core": {
      "type": "object",
      "required": [
        "summary",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Short event name"
        },
        "description": {
          "type": "string",
          "description": "Detailed event description"
        },
        "schema": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldDef"
          },
          "description": "Event payload schema"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$",
      "description": "FQDN of the artifact this one stands in place of. A declared relation between two exact identities, not a resolution rule: references stay exact, and a superseded artifact is unreachable rather than absent."
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$"
      },
      "minItems": 1,
      "description": "FQDNs of the artifacts that stand in this one's place. Several is the ordinary case \u2014 one act split in two retires one artifact and authors two. Its presence means the artifact is superseded: unreachable from the executable projections, retained in the canonical set as history."
    }
  },
  "$defs": {
    "fieldDef": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "format": {
          "type": "string",
          "description": "Format hint (e.g., date-time)"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}

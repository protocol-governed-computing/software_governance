{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgc.schemas.SCHEMA_TRANSPORT_RESPONSE_V0",
  "title": "PGC Canonical Transport Response V0",
  "description": "Protocol-neutral canonical transport response contract (Transport Standard V0 §5.2). Representation-independent; JSON is one serialization and is not itself normative.",
  "type": "object",
  "required": [
    "request_id",
    "outcome",
    "result_class"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Echoes the request's correlation handle."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILURE"
      ],
      "description": "Binary outcome."
    },
    "result_class": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "VIOLATION",
        "UNAUTHORIZED",
        "EXECUTION_FAILURE",
        "OPERATION_NOT_FOUND"
      ],
      "description": "Governed, protocol-neutral Result Class. Carries no external-protocol semantics."
    },
    "result": {
      "description": "Projected result payload on success; null on failure."
    },
    "evidence": {
      "type": "array",
      "description": "Evidence references (e.g. trace ids)."
    },
    "errors": {
      "type": "array",
      "description": "Populated on failure."
    }
  }
}

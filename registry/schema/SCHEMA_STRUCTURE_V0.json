{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software_governance/registry/schema/SCHEMA_STRUCTURE_V0.json",
  "title": "STRUCTURE artifact machine block",
  "description": "A STRUCTURE declares configuration the platform reads about itself \u2014 a build configuration, a storage declaration, a policy, a placement, a trust mode. Six fields are carried by every one of them and are required here. The rest is a wide union, and the width is a finding rather than a design: STRUCTURE is many kinds sharing one discriminator, and a surface enumerating everything anyone has declared admits nearly anything. It refuses a key nobody has ever used, which catches a typo and little else. Narrowing it means splitting the kind, which is a change to what STRUCTURE is and belongs to whoever makes that case.",
  "type": "object",
  "required": [
    "artifact_kind",
    "authority",
    "concern",
    "fqdn",
    "governed_by",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {},
    "authority": {},
    "concern": {},
    "fqdn": {},
    "governed_by": {},
    "version": {},
    "aggregation_type": {},
    "artifact_code": {},
    "artifact_discovery": {},
    "artifact_patterns": {},
    "artifact_signing_required": {},
    "artifact_source_dirs": {},
    "build_phases": {},
    "classification_level": {},
    "conformance": {},
    "contract": {},
    "core": {},
    "cross_domain_transfer_allowed": {},
    "cross_node_dispatch_allowed": {},
    "deterministic_join_required": {},
    "directory_lifecycle": {},
    "discovery": {},
    "field_types": {},
    "identity": {},
    "identity_rules": {},
    "invariants": {},
    "layer_definitions": {},
    "layer_directories": {},
    "module_data_roots": {},
    "module_data_roots_lifecycle": {},
    "namespace_mappings": {},
    "network_boundary": {},
    "non_blocking_dispatch_allowed": {},
    "normalization": {},
    "output_configuration": {},
    "packages": {},
    "parallel_branch_execution_allowed": {},
    "payload_signing_required": {},
    "placement_mode": {},
    "placement_target": {},
    "remote_execution_allowed": {},
    "required_fields": {},
    "reuse_visibility": {},
    "role_artifact_rules": {},
    "scheduling_mode": {},
    "security_domain": {},
    "snapshot_scope": {},

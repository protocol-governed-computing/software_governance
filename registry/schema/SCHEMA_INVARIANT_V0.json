{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software_governance.schemas.SCHEMA_INVARIANT_V0",
  "title": "PGC Invariant Schema V0",
  "description": "Closed machine-block contract for INVARIANT artifacts. Every accepted field has a semantic consumer or a compile-time validation role; explanatory material lives below the Machine fence.",
  "type": "object",
  "required": [
    "fqdn",
    "artifact_kind",
    "version",
    "governed_by",
    "core",
    "assert_projection"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "INVARIANT"
    },
    "version": {
      "type": "string",
      "pattern": "^V[0-9]+$"
    },
    "governed_by": {
      "description": "FQDN of the governing constitution. Source of the GOVERNED_BY edge.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_.]+::CONSTITUTION_[A-Z0-9_]+_V[0-9]+$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+::CONSTITUTION_[A-Z0-9_]+_V[0-9]+$"
          }
        }
      ]
    },
    "core": {
      "type": "object",
      "required": [
        "enforcement_stage",
        "violation_response"
      ],
      "additionalProperties": false,
      "properties": {
        "enforcement_stage": {
          "description": "Invariant class discriminator (rule_ownership.md). compiler_* stages are evaluated by an ASSERT handler in S4; runtime_outcome is enforced by a CC violation outcome and WF routing, and verified by ASSERT_RUNTIME_INVARIANT_WIRED_V0.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "compiler_discovery",
              "compiler_validation",
              "compiler_assertion",
              "compiler_meta_validation",
              "runtime_outcome"
            ]
          }
        },
        "violation_response": {
          "description": "Paired discriminator. BUSINESS_VIOLATION is admissible only for runtime_outcome invariants.",
          "enum": [
            "FAIL_IMMEDIATELY",
            "WARN",
            "BUSINESS_VIOLATION"
          ]
        },
        "runtime_binding": {
          "description": "Required for runtime_outcome invariants, forbidden otherwise. Proven against the CC result surface and WF routing by ASSERT_RUNTIME_INVARIANT_WIRED_V0.",
          "type": "object",
          "required": [
            "enforced_by",
            "enforcing_workflow",
            "violation_outcome",
            "terminal_node",
            "over_store"
          ],
          "additionalProperties": false,
          "properties": {
            "enforced_by": {
              "type": "string",
              "pattern": "^[a-z0-9_.]+::CC_[A-Z0-9_]+_V[0-9]+$"
            },
            "enforcing_workflow": {
              "type": "string",
              "pattern": "^[a-z0-9_.]+::WF_[A-Z0-9_]+_V[0-9]+$"
            },
            "violation_outcome": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "terminal_node": {
              "type": "string",
              "minLength": 1
            },
            "over_store": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assert_projection": {
      "description": "Parameters carried into the ASSERT descriptor derived from this invariant (S4 _derive_assert). Read by the bound handler via current_assert_artifact. scope.applies_to is the single declared authority for invariant applicability; domain vs platform is derived from it by kind intersection, never declared.",
      "type": "object",
      "required": [
        "applies_to_kinds"
      ],
      "additionalProperties": false,
      "properties": {
        "applies_to_kinds": {
          "description": "The artifact kinds this invariant governs. Authoritative for governance import: an invariant is domain-applicable iff this intersects the domain-instantiated kind set. Distinct axis from scope.applies_to (which is layer/surface).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "WF",
              "CC",
              "CS",
              "CT",
              "RB",
              "AC",
              "IN",
              "EV",
              "TI",
              "TE",
              "INVARIANT",
              "CONSTITUTION",
              "STRUCTURE",
              "SURFACE",
              "VOCAB",
              "SCHEMA",
              "COMPILER",
              "TEST_DATA",
              "SNAPSHOT"
            ]
          }
        },
        "handler": {
          "description": "Handler module override. Omitted means convention: <prefix>.<assert_code lowercased>.",
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "ERROR",
                "WARNING"
              ]
            },
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scope": {
          "description": "Layer/surface an invariant governs (PLATFORM, or a domain layer code). Read by surface-scoped handlers (e.g. surface closure) to filter artifacts by layer, and by the import filter: a layer-scoped invariant is surface-specific and NOT generically imported into domain builds \u2014 each surface declares its own. Optional; present only where a handler needs it. This is a distinct axis from applies_to_kinds.",
          "type": "object",
          "required": [
            "applies_to"
          ],
          "additionalProperties": false,
          "properties": {
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        },
        "ci_override": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "ERROR",
                "WARNING"
              ]
            }
          }
        },
        "allowed_capability_transforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_capability_side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composition_check": {
          "description": "Declarative specification for evaluating this invariant against an assembled composition (Composition Conformance phase). Encoding- and language-neutral: a selector over canonical artifacts plus a cardinality rule. Present iff the invariant is composition-scoped; its presence is what admits the invariant into the phase. Carries no implementation reference.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "selector"
          ],
          "properties": {
            "rule": {
              "description": "Cardinality rule the selected artifact set must satisfy.",
              "enum": [
                "exactly_one",
                "at_most_one",
                "none"
              ]
            },
            "selector": {
              "description": "Predicate selecting canonical artifacts from the assembled snapshot. All declared fields must match (logical AND). An empty selector is invalid.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "namespace": {
                  "description": "Exact match on the artifact's namespace.",
                  "type": "string",
                  "minLength": 1
                },
                "artifact_type": {
                  "description": "Exact match on the artifact's compiled type token.",
                  "type": "string",
                  "minLength": 1
                },
                "artifact_code_prefix": {
                  "description": "Artifact code must start with this string.",
                  "type": "string",
                  "minLength": 1
                },
                "where": {
                  "description": "Exact-match constraints on the artifact's declaration fields.",
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "boolean",
                      "number"
                    ]
                  }
                }
              }
            },
            "subject": {
              "description": "Human-readable name of what is being constrained, used in diagnostics.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "core": {
            "properties": {
              "enforcement_stage": {
                "contains": {
                  "const": "runtime_outcome"
                }
              }
            },
            "required": [
              "enforcement_stage"
            ]
          }
        },
        "required": [
          "core"
        ]
      },
      "then": {
        "properties": {
          "core": {
            "required": [
              "runtime_binding"
            ],
            "properties": {
              "violation_response": {
                "const": "BUSINESS_VIOLATION"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "core": {
            "not": {
              "required": [
                "runtime_binding"
              ]
            },
            "properties": {
              "violation_response": {
                "enum": [
                  "FAIL_IMMEDIATELY",
                  "WARN"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgs_governance.schemas.SCHEMA_CT_IR_V0",
  "title": "OmniBachi CT-IR Schema V0",
  "description": "JSON Schema for lowered CT-IR artifacts (compiler output). Governed by CONSTITUTION_COMPILER_V0.",
  "type": "object",
  "required": [
    "fqdn",
    "ct_composition_version",
    "artifact_code",
    "inputs",
    "atom_stream",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "ct_composition_version": {
      "type": "string",
      "const": "0",
      "description": "CT-IR format version"
    },
    "artifact_code": {
      "type": "string",
      "pattern": "^CT_[A-Z0-9_]+_V[0-9]+(_MOLECULE)?$",
      "description": "Source molecule identifier"
    },
    "ct_kind": {
      "type": "string",
      "const": "molecule",
      "description": "Always 'molecule' for CT-IR"
    },
    "inputs": {
      "type": "object",
      "description": "Input parameter definitions",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "any"
            ]
          }
        }
      }
    },
    "atom_stream": {
      "type": "array",
      "description": "Ordered sequence of atom instructions (execution order)",
      "items": {
        "$ref": "#/$defs/atomInstruction"
      }
    },
    "outputs": {
      "type": "object",
      "description": "Output definitions with source symbol references",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string",
            "description": "Symbol name from atom_stream"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "any"
            ]
          }
        }
      }
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    },
    "authority": {
      "type": "string",
      "description": "The authority from which this artifact's jurisdiction derives (CA-1, CA-2). Declared, never inferred from namespace, path or kind."
    },
    "concern": {
      "type": "string",
      "description": "The semantic subject this artifact is about (GO-11, ID-12). A concern classification confers no authority and constitutes no boundary."
    }
  },
  "$defs": {
    "atomInstruction": {
      "type": "object",
      "required": [
        "atom",
        "args",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "atom": {
          "type": "string",
          "description": "Atom instruction name or molecule CT code"
        },
        "args": {
          "type": "object",
          "description": "Resolved input arguments",
          "additionalProperties": true
        },
        "out": {
          "type": [
            "string",
            "null"
          ],
          "description": "Output symbol name"
        },
        "loop": {
          "type": "object",
          "description": "Loop configuration (for loop atoms only)",
          "properties": {
            "over": {
              "type": "string"
            },
            "iterator": {
              "type": "string"
            },
            "accumulator": {
              "type": "object"
            },
            "inputs": {
              "type": "object"
            },
            "update_accumulator": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}

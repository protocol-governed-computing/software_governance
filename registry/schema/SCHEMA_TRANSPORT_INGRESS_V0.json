{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software_governance.schemas.SCHEMA_TRANSPORT_INGRESS_V0",
  "title": "Transport Ingress Schema V0",
  "description": "The machine block of a TI artifact (Transport Standard V0 §6): the Operation Identity it admits, its input contract, its context requirements and its invocation binding. It carries no execution logic, capability reference or side effect (TI_MEMBRANE_NOT_STAGE).",
  "type": "object",
  "required": [
    "fqdn",
    "artifact_kind",
    "version",
    "governed_by",
    "operation",
    "input_contract",
    "context_requirements",
    "handler"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "TRANSPORT_INGRESS",
      "description": "Canonical artifact kind discriminator (Kind Vocabulary)."
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version string"
    },
    "governed_by": {
      "type": "string",
      "const": "transport::CONSTITUTION_TRANSPORT_INGRESS_V0",
      "description": "Governing constitution FQDN"
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$",
      "description": "FQDN of the artifact this one stands in place of. A declared relation between two exact identities, not a resolution rule: references stay exact, and a superseded artifact is unreachable rather than absent."
    },
    "authority": {
      "type": "string",
      "description": "The authority from which this artifact's jurisdiction derives (CA-1, CA-2). Declared, never inferred from namespace, path or kind."
    },
    "concern": {
      "type": "string",
      "description": "The semantic subject this artifact is about (GO-11, ID-12). A concern classification confers no authority and constitutes no boundary."
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "The Operation Identity this contract admits (standard §3). Never a workflow identity."
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "category",
        "label",
        "summary"
      ],
      "additionalProperties": false,
      "description": "How the operation is presented in a catalog of operations",
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What actor or context the operation requires; inert in V0 (standard §6)"
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/inputField"
      },
      "description": "The governed input contract the operation admits (TI_INPUT_CONTRACT_BY_REFERENCE)"
    },
    "handler": {
      "type": "object",
      "required": [
        "kind",
        "payload_template"
      ],
      "additionalProperties": false,
      "description": "The invocation binding: the governed executable target, bound statically (TI_STATIC_ROUTING)",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "WF_INVOCATION",
            "SNAPSHOT_READ",
            "SNAPSHOT_QUERY"
          ]
        },
        "workflow": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*::WF_[A-Z0-9_]+_V[0-9]+$",
          "description": "The workflow a WF_INVOCATION runs"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "description": "The inspection Operation Identity a snapshot handler answers"
        },
        "implementation": {
          "type": "object",
          "required": [
            "module",
            "callable"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"
            },
            "callable": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$"
            }
          }
        },
        "payload_template": {
          "type": "object",
          "description": "How the admitted input is laid out for the target"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "WF_INVOCATION"
              }
            }
          },
          "then": {
            "required": [
              "workflow"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "implementation"
                  ]
                },
                {
                  "required": [
                    "operation"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "SNAPSHOT_READ",
                  "SNAPSHOT_QUERY"
                ]
              }
            }
          },
          "then": {
            "required": [
              "operation",
              "implementation"
            ],
            "not": {
              "required": [
                "workflow"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "inputField": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software_governance.schemas.SCHEMA_INTENT_V0",
  "title": "Intent Schema V0",
  "description": "The machine block of an INTENT artifact: the workflow a request starts, the inputs it takes and the outcomes it answers with. Written from what INTENT artifacts declare; it replaces a description that rejected a whole number as a type and named its constitution by short code.",
  "type": "object",
  "required": [
    "fqdn",
    "artifact_kind",
    "version",
    "governed_by",
    "core"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "INTENT",
      "description": "Canonical artifact kind discriminator (Kind Vocabulary)."
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version string"
    },
    "governed_by": {
      "type": "string",
      "const": "intent::CONSTITUTION_INTENT_V0",
      "description": "Governing constitution FQDN"
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$",
      "description": "FQDN of the artifact this one stands in place of. A declared relation between two exact identities, not a resolution rule: references stay exact, and a superseded artifact is unreachable rather than absent."
    },
    "authority": {
      "type": "string",
      "description": "The authority from which this artifact's jurisdiction derives (CA-1, CA-2). Declared, never inferred from namespace, path or kind."
    },
    "concern": {
      "type": "string",
      "description": "The semantic subject this artifact is about (GO-11, ID-12). A concern classification confers no authority and constitutes no boundary."
    },
    "core": {
      "type": "object",
      "required": [
        "summary",
        "workflow",
        "inputs",
        "outcomes"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable summary of the intent"
        },
        "workflow": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_.]*::)?WF_[A-Z0-9_]+_V[0-9]+$",
          "description": "The workflow this intent starts"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inputField"
          },
          "description": "Input field definitions"
        },
        "outcomes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              }
            }
          },
          "description": "The outcomes the intent answers with"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "domain": {
          "type": "string",
          "description": "Domain namespace"
        }
      }
    }
  },
  "$defs": {
    "inputField": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array"
          ],
          "description": "Field type"
        },
        "required": {
          "type": "boolean",
          "description": "Whether the field must be present"
        },
        "default": {
          "description": "Value used when the field is absent"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgs_governance.schemas.SCHEMA_CAPABILITY_SIDE_EFFECT_V0",
  "title": "OmniBachi Capability Side Effect Schema V0",
  "description": "JSON Schema for materialized capability side effect artifacts. Structural validation only \u2014 semantic correctness governed by ASSERT_CS_* handlers.",
  "type": "object",
  "required": [
    "fqdn",
    "artifact_kind",
    "version",
    "governed_by",
    "implementation",
    "core"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "CAPABILITY_SIDE_EFFECT",
      "description": "Canonical artifact kind discriminator (Kind Vocabulary)."
    },
    "version": {
      "type": "string",
      "pattern": "^[Vv][0-9]+$",
      "description": "Version string"
    },
    "governed_by": {
      "type": "string",
      "description": "Governing constitution FQDN"
    },
    "implementation": {
      "type": "object",
      "required": [
        "module",
        "callable"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "Fully-qualified Python module path for the CS implementation"
        },
        "callable": {
          "type": "string",
          "description": "Callable name within the module"
        }
      },
      "description": "Runtime implementation binding for this side effect"
    },
    "core": {
      "type": "object",
      "required": [
        "summary",
        "operations"
      ],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Human-readable summary"
        },
        "description": {
          "type": "string",
          "description": "Detailed description"
        },
        "category": {
          "type": "string",
          "enum": [
            "storage",
            "external",
            "ephemeral",
            "execution_gateway",
            "inspection"
          ],
          "description": "Side effect category"
        },
        "policy": {
          "type": "object",
          "additionalProperties": true,
          "description": "Policy configuration for this side effect"
        },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          },
          "description": "Available operations"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "fqdn": {
      "type": "string",
      "pattern": "^[a-z0-9_.]+::[A-Z][A-Z0-9_]*_V[0-9]+$",
      "description": "Authoritative declared identity (namespace::code). Folder location has no authority over identity."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$",
      "description": "FQDN of the artifact this one stands in place of. A declared relation between two exact identities, not a resolution rule: references stay exact, and a superseded artifact is unreachable rather than absent."
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*::[A-Z][A-Z0-9_]*_V\\d+$"
      },
      "minItems": 1,
      "description": "FQDNs of the artifacts that stand in this one's place. Several is the ordinary case \u2014 one act split in two retires one artifact and authors two. Its presence means the artifact is superseded: unreachable from the executable projections, retained in the canonical set as history."
    },
    "authority": {
      "type": "string",
      "description": "The authority from which this artifact's jurisdiction derives (CA-1, CA-2). Declared, never inferred from namespace, path or kind."
    },
    "concern": {
      "type": "string",
      "description": "The semantic subject this artifact is about (GO-11, ID-12). A concern classification confers no authority and constitutes no boundary."
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "summary",
        "handler",
        "idempotent",
        "input",
        "output",
        "effect"
      ],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string",
          "description": "Operation summary"
        },
        "handler": {
          "type": "string",
          "description": "Handler method name"
        },
        "idempotent": {
          "type": "boolean",
          "description": "Whether operation is idempotent"
        },
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Input field names"
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Output field names"
        },
        "result_status_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Possible result status values"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ],
          "description": "Whether the operation changes the records it addresses. Required, because read-only reach across a subdomain boundary cannot be held without it \u2014 and `idempotent` does not answer it: a last-write-wins write is idempotent."
        }
      }
    }
  }
}
